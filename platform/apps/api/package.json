{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "description": "PiNovelStudio 商用平台后端（NestJS + Fastify + Prisma + PostgreSQL）",
  "scripts": {
    "build": "prisma generate && nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "ledger:reconcile": "tsx scripts/ledger-reconcile.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@fastify/static": "^10.1.2",
    "@nestjs/platform-fastify": "^11.1.6",
    "@prisma/client": "^6.17.0",
    "alipay-sdk": "^4.14.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fastify": "5.11.3",
    "jose": "^5.10.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^10.1.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "wechatpay-node-v3": "^2.2.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.16.1",
    "@types/node": "^24.7.0",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.2.4"
  }
}
