# ===== PiNovelStudio 商用平台（platform）环境变量 =====
# 复制为 .env 并按需修改；.env 不入库（生产环境变量见部署文档）。

# ---- 数据库（docker-compose.dev.yml 默认值；端口 15432 避免与本地 Postgres 冲突）----
DATABASE_URL=postgresql://platform:platform_dev@localhost:15432/platform?schema=public

# ---- API 服务 ----
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# ---- 认证 ----
# 至少 32 个字符；生产必须替换为强随机值
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=7d

# ---- 首个管理员（pnpm db:seed 使用；必须显式设置，不提供默认口令）----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- 首次生产部署（api-bootstrap 一次性任务；必须显式填写）----
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_GEMINI_API_KEY=
BOOTSTRAP_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# 单位：分 / 百万 token；按当前供应商合同填写，不提供示例价格。
BOOTSTRAP_GEMINI_INPUT_PRICE_PER_MILLION_FEN=
BOOTSTRAP_GEMINI_OUTPUT_PRICE_PER_MILLION_FEN=

# ---- 内部 API（novel-runtime 回调，HMAC-SHA256 + 5 分钟防重放）----
# 至少 32 个字符；生产必须替换为强随机值
INTERNAL_API_SECRET=dev-only-internal-hmac-secret-0123456789abcdef

# ---- Provider 密钥加密（AES-256-GCM，64 位 hex = 32 字节）----
# 生产必须替换；丢失则无法解密已落库的 api_key_encrypted
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===== 以下：novel-runtime（docker-compose.yml 生产组网使用）=====

# ---- 任务令牌（platform-api 签发 ↔ novel-runtime 校验，两侧共享）----
# 至少 32 个字符；生产必须替换为强随机值
NOVEL_TASK_TOKEN_HMAC_KEY=dev-only-novel-task-token-secret-0123456789abcdef

# ---- 生产 compose 数据库（docker-compose.yml 自动拼装容器内 DATABASE_URL）----
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=platform
API_PORT=3000

# ---- Provider 直连凭证（NOVEL_PROVIDER_CREDENTIALS_SOURCE=env 时注入 runtime 容器）----
# 改为 platform 则由 runtime 启动时经 GET /internal/models/credentials 拉取（Admin 加密落库）
NOVEL_PROVIDER_CREDENTIALS_SOURCE=platform
# Production runtime refuses to serve unless every listed provider key exists
# after env/platform credential injection. Keep this aligned with live routes.
NOVEL_REQUIRED_PROVIDER_KEYS=GEMINI_API_KEY
GLM_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
ARK_API_KEY=
GPT_API_KEY=

# ---- 助手规划模型（开发 stub；生产 disabled 或 http+凭证）----
PLANNER_MODE=stub
PLANNER_API_BASE_URL=
PLANNER_API_KEY=
PLANNER_MODEL=gpt-5.6
# 生产镜像默认 /app/web；开发留空，由 Vite 5173 提供前端
WEB_DIST_DIR=

# ---- 单次 LLM 请求有界超时（毫秒）----
PINOVEL_MODEL_REQUEST_TIMEOUT_MS=300000
# 整个章节编排 HTTP 请求超时（应大于单次模型请求超时）。
NOVEL_RUNTIME_REQUEST_TIMEOUT_MS=900000

# ---- 支付（本文件为开发环境；生产 compose 必须显式 PAYMENT_MODE=live）----
# 生产不得使用 stub，且必须配置 PAYMENT_NOTIFY_BASE_URL 及至少一个完整商户渠道凭证。
PAYMENT_MODE=stub
PAYMENT_STUB_SECRET=dev-only-payment-stub-secret-0123456789ab
PAYMENT_ORDER_EXPIRE_MINUTES=30
PAYMENT_NOTIFY_BASE_URL=http://127.0.0.1:3000
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_CERT=
# Must equal the codeCommit frozen in the active production release manifest.
# The runtime image has no .git checkout and fails closed if this is absent.
PINOVEL_RELEASE_COMMIT=
