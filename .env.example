# PiNovelStudio 环境变量

# =============================================================================
# GLM-5.2 (智谱AI) — 备选创作 + 风格塑形
# 官网: console.volcengine.com
# =============================================================================
GLM_API_KEY=your-glm-api-key
GLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
GLM_MODEL=glm-5.2

# =============================================================================
# DeepSeek V4 Pro — 主力内容创作 (Narrator)
# =============================================================================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# =============================================================================
# Qwen 3.7 Plus (阿里) — 备选创作 + 测试对比
# =============================================================================
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://station.snowfish.love/v1
QWEN_MODEL=qwen3.7-plus

# =============================================================================
# Claude Opus 4.6 — raw 正文 / 普通 editorial candidate 主写 + StyleShaper + Stage 8 final gate + character_agent
# MODEL-ROUTING-CLAUDE46-1B: 全项目 Claude 路由统一切换到 claude-opus-4-6
# =============================================================================
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_BASE_URL=https://api.opusclaw.me/v1
CLAUDE_MODEL=claude-opus-4-6
CLAUDE_BACKUP_API_KEY=your-claude-backup-api-key

# =============================================================================
# GPT 5.5 — 结构化检查 (Anti-AI Detector)
# =============================================================================
GPT_API_KEY=your-gpt-api-key
GPT_BASE_URL=https://api.opusclaw.me/v1
GPT_BACKUP_API_KEY=your-gpt-backup-api-key

# =============================================================================
# 数据源路径 (100+ 部网文全文)
# =============================================================================
NOVEL_CORPUS_PATH=D:/Download/delete

# =============================================================================
# Doubao Seed 2.0 Mini (?????)
# =============================================================================
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-mini-260428

# =============================================================================
# ERNIE 5.1 (百度千帆 ModelBuilder) — 内容生成主力备选候选 (v4.8.0)
# 官网: cloud.baidu.com/product/wenxinworkshop
# 文档: https://cloud.baidu.com/doc/qianfan-api/s/3m7of64lb
# 鉴权: Authorization: Bearer <ERNIE_API_KEY>（API Key 格式 bce-v3/...）
# 用途: modelTestRoute='ernie' 触发 A/B 对比；replay 验证后晋级生产 fallback
# =============================================================================
ERNIE_API_KEY=your-ernie-api-key
ERNIE_BASE_URL=https://qianfan.baidubce.com/v2
ERNIE_MODEL=ernie-5.1

# =============================================================================
# 统一主链路（Phase 7：PINOVEL_UNIFIED_PIPELINE 环境变量已移除）
# 详见 AGENTS.md "目标架构：统一主链路" 与
#      docs/top-tier-chinese-novel-system-development-plan.md Phase 5/7
# - novel_generate_chapter 始终走唯一统一主链路（raw → editorial → judge → select → commit）
# - 无生产回滚分支：PINOVEL_UNIFIED_PIPELINE 不再存在于代码中
# - Stage0-8 legacy 链路仅通过 novel_generate_chapter_legacy_test 测试工具访问
#   （__forceLegacyChain 内部标记，不在生产路径暴露）
# - V2_FORCE_STUB=1：仅用于测试，使统一主链路使用 stub 模型（无真实 API 调用）
# =============================================================================
# V2_FORCE_STUB=1

# =============================================================================
# NovelOS M1.3 GPT-5.6-sol 盲测裁判（P1-2）
# 第三方兼容路由，模型/Base URL/Key 从 env 读取，不硬编码。
# GPT-5.6-sol 非官方 OpenAI model ID，按第三方兼容端点处理。
# 仅用于 eval 脚本盲测裁判，不进生产 fallback 链。
# =============================================================================
NOVELOS_JUDGE_API_KEY=your-novelos-judge-api-key
NOVELOS_JUDGE_BASE_URL=https://shunfen6.win/v1
NOVELOS_JUDGE_MODEL=gpt-5.6-sol

