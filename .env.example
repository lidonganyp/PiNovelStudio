# PiNovelStudio production environment template
# Secrets belong in a local .env file and must never be committed.

# Default production writer: gpt-6-astra via the shunfen6.win gateway.
GPT_API_KEY=your-gpt-api-key
GPT_BASE_URL=https://shunfen6.win/v1
GPT_MODEL=gpt-5.5
GPT_WRITER_MODEL=gpt-6-astra

# Explicit user-selected alternative writer (never an automatic fallback).
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-opus-4-6

# Retained eval-only Gemini routes (nb4_generate_gemini31 / reader-experience judge).
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GEMINI_BASE_URL=https://aimagichub.xyz/v1
GEMINI_MODEL=gemini-3.8-flash

# Optional request guardrail used by the production orchestrator.
# PINOVEL_MODEL_REQUEST_TIMEOUT_MS=300000
# NOVEL_RUNTIME_REQUEST_TIMEOUT_MS=900000
