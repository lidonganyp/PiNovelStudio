# PiNovelStudio 环境变量
# =============================================================================
# 路由真相源为 config/model-routing.json v4.20.0。
# 本文件列示需要通过 .env 注入的 API 密钥、运行时开关，以及 env override 类 model 字段。
# provider base_url 与默认 model 以 model-routing.json 为准；
# 仅 env override 类 model 字段（CLAUDE_MODEL / NOVELOS_JUDGE_MODEL 等，注册于 utils/config.ts modelOverrideEnvMap）在此列示。

# =============================================================================
# Claude Opus 4.6 — raw 正文 / 普通 editorial candidate 主写 + StyleShaper + Stage 8 final gate + character_agent
# MODEL-ROUTING-CLAUDE46-1B: 全项目 Claude 路由统一到 claude-opus-4-6
# =============================================================================
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_BACKUP_API_KEY=your-claude-backup-api-key
CLAUDE48_API_KEY=your-claude-4-8-api-key
CLAUDE48_BASE_URL=https://aimagichub.xyz/v1
CLAUDE48_MODEL=claude-opus-4-8
FABLE5_API_KEY=your-fable-5-api-key
FABLE5_BASE_URL=https://aimagichub.xyz/v1
FABLE5_MODEL=claude-fable-5
GROK45_API_KEY=your-grok-4-5-api-key
GROK45_BASE_URL=https://aimagichub.xyz/v1
GROK45_MODEL=grok-4.5
GEMINI31_API_KEY=your-gemini-3-1-api-key
GEMINI31_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI31_MODEL=gemini-3.1-pro-preview
# Production co-primary writer routes (writerModel=gemini31)
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.1-pro-preview
# env override：未设置时使用 model-routing.json 默认 model；设置后覆盖默认值（如 A/B 对比切换 claude-opus-4-8）
CLAUDE_MODEL=claude-opus-4-6

# =============================================================================
# GPT 5.5 — 结构化节点 + 异源 judge 基座（v2_opportunity_judge / v2_literary_judge 走 gpt-5.6-sol 端点）
# =============================================================================
GPT_API_KEY=your-gpt-api-key
GPT_BACKUP_API_KEY=your-gpt-backup-api-key

# =============================================================================
# Doubao Seed 2.1 Pro — 受限中文校准候选（仅 v2_chinese_calibration，span 驱动）
# MODEL-ROUTING-CLAUDE46-1C: Doubao 不再担任正文主写，降为受限中文校准器
# =============================================================================
ARK_API_KEY=your-ark-api-key

# =============================================================================
# NovelOS 异源 judge — gpt-5.6-sol 第三方兼容端点
# v2_opportunity_judge / v2_literary_judge / novel_quality_judge 使用
# model/base_url/api_key 全部从此 env 读取，不进生产 fallback 链
# =============================================================================
NOVELOS_JUDGE_API_KEY=your-novelos-judge-api-key
NOVELOS_JUDGE_BASE_URL=https://shunfen6.win/v1
NOVELOS_JUDGE_MODEL=gpt-5.6-sol

# =============================================================================
# GLM 5.2 — 仅显式开发/NovelBench testing route（lab_testing=true，fallback=[]）
# 不得进入生产默认或 fallback；生产默认调用数必须为 0
# =============================================================================
GLM_API_KEY=your-glm-api-key

# =============================================================================
# ERNIE 5.1 — disabled_providers，仅旧 trace/replay 解析保留
# 不得发起新调用；stage2_loopback_policy=disabled
# =============================================================================
# ERNIE_API_KEY=your-ernie-api-key

# =============================================================================
# 运行时开关
# =============================================================================
# 模型请求 bounded timeout（毫秒），默认 300000（5 分钟）
# PINOVEL_MODEL_REQUEST_TIMEOUT_MS=300000

# 开发模式：G6 生产门禁 bypass（仅开发/测试使用，生产不得设置）
# PINOVEL_DEV_MODE=1

# 临时/批量测试仅允许 GLM/Doubao，禁止 fallback 到 GPT/Claude
# PINOVEL_DISABLE_FALLBACK=1

# NovelBench 成本档位：package_screening（仅 GLM/Doubao）或 production_validation（仅 GPT/Claude）
# PINOVEL_BENCHMARK_COST_PROFILE=package_screening

# =============================================================================
# 已停用 — 以下 provider 已退出生产链路，保留仅供旧 trace/replay 解析
# =============================================================================
# DeepSeek V4 Flash: v4.5.0 退出所有默认生产节点，仅保留测试路由
# Qwen 3.7 Plus: disabled_providers，无可用余额
# 原始 corpus/ 已从仓库删除（7.75GB），生产路径对原始语料零依赖
# 离线重建数据须由使用者提供外部语料路径，不再通过 NOVEL_CORPUS_PATH 配置
