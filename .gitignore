# =============================================================================
.pi/extensions/novel-studio/eval/fixtures/closure-*/
.pi/extensions/novel-studio/eval/fixtures/ceg-wave5-6/

# 一次性调试脚本（_tmp 前缀）
.pi/extensions/novel-studio/scripts/_tmp*.mjs
